# Load it
library(AffDis)
A <- diag(c(1, 2))
B <- diag(c(4, 3))
C <- matrix(c(2, 0.5,
0.5, 2), nrow = 2)
# Combine matrices into a 3D array
mats <- array(NA, dim = c(2, 2, 3))
mats[,,1] <- A
mats[,,2] <- B
mats[,,3] <- C
# Calculate pairwise squared AIRM distances
D <- affinv_metric_cpp(mats)
